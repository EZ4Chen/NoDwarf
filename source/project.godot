; Engine configuration file. Open with the Godot .NET editor.
config_version=5

[application]
config/name="NoDwarf"
run/main_scene="res://Scenes/Startup.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]
Diagnostics="*res://Scripts/AppDiagnostics.cs"

[dotnet]
project/assembly_name="NoDwarf"

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1152
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.075, 0.095, 1)
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true

[physics]
common/physics_ticks_per_second=60

[performance]
threads/forest_upload_budget_ms=3.0
cache/pawn_body_mib=128
cache/pawn_hands_mib=8
cache/pawn_portraits_mib=128
