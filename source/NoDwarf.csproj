<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MoonSharp" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Simulation/**/*.cs;Services/Llm/**/*.cs;MenuLogic/**/*.cs;Core/**/*.cs" />
    <ProjectReference Include="Core/NoDwarf.Core.csproj" />
  </ItemGroup>
  <!-- Editor/check builds only. Neither debug nor release exports include test code. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);NODWARF_CHECKS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Development/**/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <ProjectReference Include="../tools/checks/simulation/SimulationChecks.csproj" />
  </ItemGroup>
</Project>
