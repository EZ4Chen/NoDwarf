  <Recipes>
    <Recipe id="splint" name="夹板：1 木料 + 1 布 → 2 夹板" station="Workbench" output="splint" count="2" work="5">
      <Ingredient item="wood" count="1" />
      <Ingredient item="cloth" count="1" />
    </Recipe>
    <Recipe id="prosthesis" name="木制义肢：3 木料 + 1 布 → 义肢" station="Workbench" output="prosthesis" count="1" work="5">
      <Ingredient item="wood" count="3" />
      <Ingredient item="cloth" count="1" />
    </Recipe>
    <Recipe id="bucket" name="水桶：2 木料 → 水桶" station="Workbench" output="bucket" count="1" work="5">
      <Ingredient item="wood" count="2" />
    </Recipe>
    <Recipe id="compost" name="处理腐败物：2 腐败物 → 土壤" station="Workbench" output="soil" count="1" work="5">
      <Ingredient item="rot" count="2" />
    </Recipe>
    <Recipe id="flour" name="磨粉：2 小麦 → 2 面粉" station="Mill" output="flour" count="2" work="5">
      <Ingredient item="wheat" count="2" />
    </Recipe>
    <Recipe id="bread" name="烘焙：2 面粉 + 1 木料 → 3 口粮" station="Stove" output="meal" count="3" work="5">
      <Ingredient item="flour" count="2" />
      <Ingredient item="wood" count="1" />
    </Recipe>
    <Recipe id="potato_meal" name="煮土豆：2 土豆 + 1 木料 → 2 口粮" station="Stove" output="meal" count="2" work="5">
      <Ingredient item="potato" count="2" />
      <Ingredient item="wood" count="1" />
    </Recipe>
    <Recipe id="mushroom_meal" name="蘑菇餐：2 蘑菇 + 1 木料 → 2 口粮" station="Stove" output="meal" count="2" work="5">
      <Ingredient item="mushroom" count="2" />
      <Ingredient item="wood" count="1" />
    </Recipe>
    <Recipe id="cloth" name="织布：4 棉絮 → 2 布" station="Loom" output="cloth" count="2" work="5">
      <Ingredient item="cotton" count="4" />
    </Recipe>
    <Recipe id="bandages" name="裁绷带：1 布 → 3 绷带" station="Loom" output="bandage" count="3" work="5">
      <Ingredient item="cloth" count="1" />
    </Recipe>
    <Recipe id="shirt" name="裁布衣：2 布 → 布衣" station="Loom" output="shirt" count="1" work="5">
      <Ingredient item="cloth" count="2" />
    </Recipe>
    <Recipe id="trousers" name="裁布裤：2 布 → 布裤" station="Loom" output="trousers" count="1" work="5">
      <Ingredient item="cloth" count="2" />
    </Recipe>
    <Recipe id="shield" name="木盾：4 木料 → 木盾" station="Workbench" output="shield" count="1" work="5">
      <Ingredient item="wood" count="4" />
    </Recipe>
    <Recipe id="rubble" name="碎石整形：2 深板岩碎石 → 2 圆石" station="Workbench" output="cobblestone" count="2" work="5">
      <Ingredient item="deep_rubble" count="2" />
    </Recipe>
    <Recipe id="pickaxe" name="锻镐：2 铁锭 + 1 木料 → 矿镐" station="Anvil" output="pickaxe" count="1" work="5">
      <Ingredient item="iron" count="2" />
      <Ingredient item="wood" count="1" />
    </Recipe>
    <Recipe id="hammer" name="锻锤：1 铁锭 + 1 木料 → 锻锤" station="Anvil" output="hammer" count="1" work="5">
      <Ingredient item="iron" count="1" />
      <Ingredient item="wood" count="1" />
    </Recipe>
    <Recipe id="axe" name="铁斧：2 铁锭 + 1 木料 → 铁斧" station="Anvil" output="axe" count="1" work="5">
      <Ingredient item="iron" count="2" />
      <Ingredient item="wood" count="1" />
    </Recipe>
    <Recipe id="battleaxe" name="双刃战斧：3 铁锭 + 2 木料 → 双刃战斧" station="Anvil" output="battleaxe" count="1" work="5">
      <Ingredient item="iron" count="3" />
      <Ingredient item="wood" count="2" />
    </Recipe>
    <Recipe id="shovel" name="铁铲：1 铁锭 + 2 木料 → 铁铲" station="Anvil" output="shovel" count="1" work="5">
      <Ingredient item="iron" count="1" />
      <Ingredient item="wood" count="2" />
    </Recipe>
    <Recipe id="hoe" name="铁锄：2 铁锭 + 2 木料 → 铁锄" station="Anvil" output="hoe" count="1" work="5">
      <Ingredient item="iron" count="2" />
      <Ingredient item="wood" count="2" />
    </Recipe>
    <Recipe id="cook" name="烹饪：2 食材 + 1 木料 → 2 口粮" station="Stove" output="meal" count="2" work="5">
      <Ingredient item="raw_food" count="2" />
      <Ingredient item="wood" count="1" />
    </Recipe>
    <Recipe id="smelt" name="熔炼：2 粗铁 + 1 煤 → 2 铁锭" station="Furnace" output="iron" count="2" work="5">
      <Ingredient item="raw_iron" count="2" />
      <Ingredient item="coal" count="1" />
    </Recipe>
    <Recipe id="sword" name="锻造：2 铁锭 + 1 煤 → 铁剑" station="Anvil" output="sword" count="1" work="5">
      <Ingredient item="iron" count="2" />
      <Ingredient item="coal" count="1" />
    </Recipe>
  </Recipes>
  <Modes>
    <Mode id="count" label="做 X 次" behavior="count" defaultCount="1" />
    <Mode id="maintain" label="维持 X 个" behavior="maintain" defaultCount="10" />
    <Mode id="forever" label="不限次数" behavior="forever" defaultCount="10" />
  </Modes>
</ProductionDefinitions>