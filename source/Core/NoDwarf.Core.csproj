<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Simulation/*.cs;../Services/Llm/*.cs;../MenuLogic/*.cs" />
    <EmbeddedResource Include="../Assets/Combat/*.json;../Assets/Definitions/*.xml" LogicalName="NoDwarf.%(Filename)%(Extension)" />
    <!-- Scene adapter access; checks and benchmarks are development-only friends. -->
    <InternalsVisibleTo Include="NoDwarf" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <InternalsVisibleTo Include="NavigationBench" />
    <InternalsVisibleTo Include="CoreChecks" />
    <InternalsVisibleTo Include="NoDwarf.SimulationChecks" />
    <InternalsVisibleTo Include="ExtensionChecks" />
  </ItemGroup>
</Project>
