<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="Godot bundled packages" value=".local/godot-packages" />
    <!-- Self-contained exports restore the platform-specific .NET runtime. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
